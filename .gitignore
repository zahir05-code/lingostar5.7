# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - 실제 키가 담긴 파일은 절대 커밋 금지
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# .env.example 은 안전한 템플릿이므로 GitHub에 올림 (예외)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
